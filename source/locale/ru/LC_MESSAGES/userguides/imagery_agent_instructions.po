msgstr "Рекомендуется"

#: ../userguides/imagery_agent_instructions.rst:189
#: 187b6393c9984469a57fb322c07b767e
msgid "0.0–100. Default suggestion: 10.0 (10%) for optical analysis."
msgstr "0,0–100. Предложение по умолчанию: 10,0 (10%) для оптического анализа."

#: ../userguides/imagery_agent_instructions.rst:190
#: d4d0fa21f1d648d49e9c77a6a11c7d06
msgid "**Max off-nadir angle**"
msgstr "**Макс. угол отклонения от надира**"

#: ../userguides/imagery_agent_instructions.rst:191
#: ../userguides/imagery_agent_instructions.rst:194
#: ../userguides/imagery_agent_instructions.rst:200
#: a34b66d2f6f74ddba8e48bada11bc15a b4b0d4afd8ff441fa1a3b9d8d88634f7
#: be20bec56178404eaf881c4ff877f6fd
msgid "Optional"
msgstr "Необязательный"

#: ../userguides/imagery_agent_instructions.rst:192
#: 961bc76989e54be4a3098c29da5c58cc
msgid "Lower values = more vertical (nadir) imagery = less distortion."
msgstr ""
"Более низкие значения = больше вертикальных (надирных) изображений = "
"меньше искажений."

#: ../userguides/imagery_agent_instructions.rst:193
#: 18bed717c01b446aa794bcf5881325a2
msgid "**Min AOI intersection**"
msgstr "**Минимальный угол обзора**"

