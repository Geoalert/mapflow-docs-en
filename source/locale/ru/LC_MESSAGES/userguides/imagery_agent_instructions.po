#: 3e2d68392fe64d82b56d0bb9575b34ea 4ee1d6821af4481fac91e4540ecb214e
msgid "Yes"
msgstr "Да"

#: ../userguides/imagery_agent_instructions.rst:183
#: 9630d808805a471190a697ca67925cae
msgid ""
"GeoJSON Polygon or MultiPolygon. The user can provide coordinates, draw "
"on a map, or upload a GeoJSON file."
msgstr ""
"GeoJSON Polygon или MultiPolygon. Пользователь может указать координаты, "
"нарисовать на карте или загрузить файл GeoJSON."

#: ../userguides/imagery_agent_instructions.rst:184
#: b38233e848b64eaf83bb9d3abe758f02
