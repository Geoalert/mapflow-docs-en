#: db305dad7ec24ba39d9085745a530bf6
msgid "The answer determines which sub-path to follow."
msgstr "Ответ определяет, по какому подпути следовать."

#: ../userguides/imagery_agent_instructions.rst:127
#: 1578f34a899b4d5f88fb7f07a66f70a2
msgid "4.1 Date is NOT relevant → Imagery Basemap"
msgstr "4.1 Дата НЕ имеет значения → Базовая карта изображений"

