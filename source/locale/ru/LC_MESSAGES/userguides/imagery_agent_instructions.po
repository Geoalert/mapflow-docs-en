#: d444384085ba42868dab0068e247ba82
msgid "Provider"
msgstr "Поставщик"

#: ../userguides/imagery_agent_instructions.rst:138
#: 7f576a539a2b4d9da65499518db0d4c4
msgid "When to recommend"
msgstr "Когда рекомендовать"

#: ../userguides/imagery_agent_instructions.rst:139
#: 06d31a71b75542218f57700d77b442c5
msgid "**Mapbox Satellite**"
msgstr "**Картографический спутник**"

#: ../userguides/imagery_agent_instructions.rst:140
#: 7d8b1209bd6a4c3aaf8b70e3b7530f0a
msgid ""
"General-purpose global coverage; date of image cannot be chosen. Good "
