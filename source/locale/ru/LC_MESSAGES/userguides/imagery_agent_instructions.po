#: 8c98875688fa4380bae89205aea01ed3
msgid "**Max cloud cover**"
msgstr "**Максимальная облачность**"

#: ../userguides/imagery_agent_instructions.rst:188
#: ../userguides/imagery_agent_instructions.rst:197
#: 8ab5d3b26d814570b7cfa6920cc8e2ef e47f61071975407bb4d237cbbc4fae1d
