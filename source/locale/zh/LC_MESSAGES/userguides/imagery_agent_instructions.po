#: ../userguides/imagery_agent_instructions.rst:179
#: 4255964ea21244f88bbcdb5a46efea56
msgid "Required"
msgstr "必需的"

#: ../userguides/imagery_agent_instructions.rst:180
#: 424e00ac326a473da7d7cd0a56dd2ee7
msgid "Description"
msgstr "描述"

#: ../userguides/imagery_agent_instructions.rst:181
#: 3a5a64e1ebca45d99b60d62390c03a01
msgid "**Area of Interest (AOI)**"
msgstr "**感兴趣区域 (AOI)**"

#: ../userguides/imagery_agent_instructions.rst:182
#: ../userguides/imagery_agent_instructions.rst:185
#: 3e2d68392fe64d82b56d0bb9575b34ea 4ee1d6821af4481fac91e4540ecb214e
msgid "Yes"
msgstr "是的"

#: ../userguides/imagery_agent_instructions.rst:183
#: 9630d808805a471190a697ca67925cae
msgid ""
"GeoJSON Polygon or MultiPolygon. The user can provide coordinates, draw on a"
" map, or upload a GeoJSON file."
msgstr "GeoJSON 多边形或多多边形。用户可以提供坐标、在地图上绘图或上传 GeoJSON 文件。"

#: ../userguides/imagery_agent_instructions.rst:184
