#: 187b6393c9984469a57fb322c07b767e
msgid "0.0–100. Default suggestion: 10.0 (10%) for optical analysis."
msgstr "0.0–100。默认建议：10.0 (10%) 用于光学分析。"

#: ../userguides/imagery_agent_instructions.rst:190
#: d4d0fa21f1d648d49e9c77a6a11c7d06
msgid "**Max off-nadir angle**"
msgstr "**最大偏离最低点角度**"

#: ../userguides/imagery_agent_instructions.rst:191
#: ../userguides/imagery_agent_instructions.rst:194
#: ../userguides/imagery_agent_instructions.rst:200
#: a34b66d2f6f74ddba8e48bada11bc15a b4b0d4afd8ff441fa1a3b9d8d88634f7
#: be20bec56178404eaf881c4ff877f6fd
