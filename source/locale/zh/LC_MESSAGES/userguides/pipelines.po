msgstr "合并差距；"

#: ../userguides/roads_model.rst:16 6496577024ba4bf5abf56135bb826497
msgid "removal of double edges;"
msgstr "去除双边；"

#: ../userguides/roads_model.rst:17 74cd8c1fb62c4a0b96139338851d1f87
msgid "removal of detached and too short segments;"
msgstr "去除分离的和过短的片段；"

