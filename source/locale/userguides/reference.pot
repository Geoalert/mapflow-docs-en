#: ../userguides/reference.rst:16
#: f50fd3e2f6c34a108af53f695d6b8b61
msgid "Please pay attention to the following:"
msgstr ""

#: ../userguides/reference.rst:18
#: 97b5bb8a20ba4da6b270e6ee07c50cbd
msgid "Images you upload are preprocessed in `Uint8` format. If your image is not of this type and you want to preview it manually before uploading to the Mapflow server, please use our `image preprocessing script <https://github.com/Geoalert/mapflow_data_preprocessor/>`_ or other tools to translate it to the appropriate format;"
msgstr ""

#: ../userguides/reference.rst:19
#: 0af9b610d2064603981271c54406a890
msgid "Your image must be georeferenced in geographic or projected coordinate system, ellipsoid WGS84, it is recommended to use UTM or Web Mercator;"
msgstr ""

#: ../userguides/reference.rst:20
#: 84cad41cad0f41ef81a4cd917a26cee4
msgid "The default limit for file size is ``1 Gb`` for free users. If you have a bigger file – reduce its size or consider switching to the paid plan;"
msgstr ""

#: ../userguides/reference.rst:21
#: 6d269757a47e41e6ad25c53bfb04d929
msgid "Your image should be RGB composite, RGBa or Singleband;"
msgstr ""

#: ../userguides/reference.rst:22
#: 73cbf3a8a5824f14ad7e78e99feb52dc
msgid "Maximum image dimensions: ``65535 px`` per side;"
msgstr ""

#: ../userguides/reference.rst:23
#: bd7270211f38474fbacfe2c892684cf4
msgid "Pixel size must not exceed ``20 m/px``;"
msgstr ""

#: ../userguides/reference.rst:24
#: a3d81ba2ca6d4550a5fb054548b4ca68
msgid "Images with a pixel size less than ``10 cm/px`` will be resampled to this resolution;"
msgstr ""

#: ../userguides/reference.rst:25
#: 9d707483b96a4e7881f30018945f9227
msgid "All images within a collection must have the same number of bands;"
msgstr ""

#: ../userguides/reference.rst:26
#: 981c64813a5940feafb6235e81edad51
msgid "Uploaded image will be reprojected and resampled to match the CRS and GSD (pixel size) of other images in collection;"
msgstr ""

#: ../userguides/reference.rst:27
#: ba35cec87876458fa14b80d979ca9cce
msgid "Each Mapflow model has its recommendations for the spatial resolution of the input data, see :ref:`Model_requirements` below."
msgstr ""

#: ../userguides/reference.rst:29
#: 59980564e9034f84871d833133bbf48f
msgid "In case of non-compliance with any requirements, the system reports an error. If you are using Mapflow Web or Mapflow QGIS plugin, the error messages are shown in the user interface. For more details, see :doc:`errors description <../api/error_messages>`."
msgstr ""

