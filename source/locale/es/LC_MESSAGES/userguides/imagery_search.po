msgstr ""
"Para iniciar el procesamiento utilizando los datos de Búsqueda de imágenes, "
"debe:"

#: ../userguides/imagery_search.rst:36 af077e025d484a44b2836fb1126096ed
msgid "Select a date range or a specific date;"
msgstr "Seleccione un rango de fechas o una fecha específica;"

