#: ../userguides/combo_model.rst:1 cd113a0c8ec24e53848e22180aa011b2
msgid ""
"Run Buildings, Roads and Forest detection in a single Mapflow workflow and "
"get one topology-corrected GeoJSON output."
msgstr ""
"Ejecuta la detección de edificios, carreteras y bosque en un solo flujo de "
"Mapflow y obtén un único GeoJSON con topología corregida."

#: ../userguides/combo_model.rst:7 5afedb14f1e6430e99dcbd1aea88e9ed
msgid "Buildings + Roads + Forest"
msgstr "Edificios + Carreteras + Bosques"

